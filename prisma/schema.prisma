generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  password           String
  firstName          String?
  lastName           String?
  phone              String?
  role               UserRole
  status             MemberStatus          @default(ACTIVE)
  profileImage       String?
  emailVerified      DateTime?
  mfaEnabled         Boolean               @default(false)
  mfaSecret          String?
  identityFlagStatus String?               @default("VERIFIED")
  lastLogin          DateTime?
  loginAttempts      Int                   @default(0)
  lockoutUntil       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  currency           String                @default("USD")
  dataRegion         String                @default("us-east-1")
  locale             String                @default("en-US")
  organizationId     String?
  taxJurisdiction    String?
  comments           Comment[]
  company            Company?
  creatorSubs        CreatorSubscription[] @relation("CreatorSubs")
  subscriberSubs     CreatorSubscription[] @relation("SubscriberSubs")
  likes              Like[]
  member             Member?
  mentor             Mentor?
  receivedMessages   Message[]             @relation("receiver")
  sentMessages       Message[]             @relation("sender")
  notifications      Notification[]
  posts              Post[]
  realEstateAgent    RealEstateAgent?
  subscription       Subscription?
  tafeCoordinator    TAFECoordinator?
  organization       Organization?         @relation(fields: [organizationId], references: [id])
  wallet             Wallet?
  sentTransactions   Transaction[]         @relation("SentTransactions")
  receivedTransactions Transaction[]       @relation("ReceivedTransactions")
  videoViews         VideoView[]

  @@index([email])
  @@index([role])
}

model Member {
  id                   String               @id @default(cuid())
  userId               String               @unique
  dateOfBirth          DateTime?
  gender               MemberGender?
  culturalBackground   String?
  safetyStatus         SafetyStatus         @default(SAFE)
  dlpEnabled           Boolean              @default(true)
  annualIncome         Float?
  employmentStatus     String?
  currentPathway       String?
  pathwayProgress      Int                  @default(0)
  currentHousingStatus String?
  educationLevel       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  profileData          Json?
  budgets              Budget[]
  enrollments          CourseEnrollment[]
  emergencyContacts    EmergencyContact[]
  expenses             Expense[]
  goals                Goal[]
  housingApplications  HousingApplication[]
  jobApplications      JobApplication[]
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  wellnessMetrics      WellnessMetric[]
  wellnessSession      WellnessSession[]
  mentors              Mentor[]             @relation("MemberToMentor")

  @@index([userId])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  memberId     String
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Goal {
  id          String    @id @default(cuid())
  memberId    String
  title       String
  description String?
  category    String
  targetDate  DateTime?
  status      String    @default("IN_PROGRESS")
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Company {
  id              String           @id @default(cuid())
  userId          String           @unique
  companyName     String           @unique
  abn             String?          @unique
  industry        String?
  description     String?
  website         String?
  phone           String?
  address         String?
  employeeCount   Int?
  yearEstablished Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListings     Job[]
  jobApplications JobApplication[]

  @@index([userId])
}

model Job {
  id           String           @id @default(cuid())
  companyId    String
  title        String
  description  String
  requirements String?
  salaryMin    Float?
  salaryMax    Float?
  jobType      String
  location     String?
  status       String           @default("OPEN")
  postedDate   DateTime         @default(now())
  closingDate  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId])
}

model JobApplication {
  id            String    @id @default(cuid())
  memberId      String
  jobId         String
  companyId     String
  status        String    @default("APPLIED")
  coverLetter   String?
  resume        String?
  appliedDate   DateTime  @default(now())
  interviewDate DateTime?
  offerDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, jobId])
  @@index([memberId])
  @@index([jobId])
  @@index([companyId])
}

model Mentor {
  id             String          @id @default(cuid())
  userId         String          @unique
  specialization String[]
  experience     Int?
  bio            String?
  availability   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       MentorSession[]
  mentees        Member[]        @relation("MemberToMentor")

  @@index([userId])
}

model MentorSession {
  id          String   @id @default(cuid())
  mentorId    String
  topic       String
  notes       String?
  sessionDate DateTime
  duration    Int?
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

model TAFECoordinator {
  id              String   @id @default(cuid())
  userId          String   @unique
  institutionName String?
  department      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  courses         Course[]
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Course {
  id            String             @id @default(cuid())
  coordinatorId String
  title         String
  description   String?
  duration      Int?
  level         String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  coordinator   TAFECoordinator    @relation(fields: [coordinatorId], references: [id], onDelete: Cascade)
  enrollments   CourseEnrollment[]

  @@index([coordinatorId])
}

model CourseEnrollment {
  id             String    @id @default(cuid())
  memberId       String
  courseId       String
  enrollmentDate DateTime  @default(now())
  status         String    @default("ENROLLED")
  completionDate DateTime?
  grade          String?
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([memberId])
  @@index([courseId])
}

model RealEstateAgent {
  id              String     @id @default(cuid())
  userId          String     @unique
  agencyName      String?
  licenseNumber   String?
  specializations String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  properties      Property[]
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id                  String               @id @default(cuid())
  agentId             String
  address             String
  suburb              String?
  postcode            String?
  bedrooms            Int?
  bathrooms           Int?
  parkingSpaces       Int?
  type                String
  rentalPrice         Float?
  status              String               @default("AVAILABLE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  housingApplications HousingApplication[]
  agent               RealEstateAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model HousingApplication {
  id              String    @id @default(cuid())
  memberId        String
  propertyId      String
  status          String    @default("PENDING")
  applicationDate DateTime  @default(now())
  approvalDate    DateTime?
  moveInDate      DateTime?
  monthlyIncome   Float?
  employment      String?
  references      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([memberId, propertyId])
  @@index([memberId])
  @@index([propertyId])
}

model Budget {
  id          String           @id @default(cuid())
  memberId    String
  name        String
  month       DateTime
  totalAmount Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  categories  BudgetCategory[]
  expenses    Expense[]

  @@index([memberId])
}

model PersonalAccessToken {
  id            BigInt   @id @default(autoincrement())
  tokenableId   String   @map("tokenable_id")
  tokenableType String   @map("tokenable_type")
  name          String?
  token         String
  abilities     String?
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([tokenableType, tokenableId], name: "personal_access_tokens_tokenable_type_tokenable_id_index")
  @@unique([id, token], name: "personal_access_tokens_id_token_unique")
  @@map("personal_access_tokens")
}

model BudgetCategory {
  id              String @id @default(cuid())
  budgetId        String
  name            String
  allocatedAmount Float
  budget          Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Expense {
  id          String   @id @default(cuid())
  memberId    String
  budgetId    String
  description String
  amount      Float
  category    String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([budgetId])
}

model WellnessSession {
  id              String   @id @default(cuid())
  memberId        String
  topic           String
  conversation    String?
  recommendations String?
  mood            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model WellnessMetric {
  id           String   @id @default(cuid())
  memberId     String
  metricType   String
  value        Float
  notes        String?
  recordedDate DateTime
  createdAt    DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model AIConciergeRequest {
  id        String   @id @default(cuid())
  userId    String
  request   String
  response  String?
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Organization {
  id             String            @id @default(cuid())
  name           String
  type           String
  email          String?
  website        String?
  logo           String?
  verified       Boolean           @default(false)
  followers      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  metadata       String?
  billingAccount AdBillingAccount?
  campaigns      AdCampaign[]
  creatives      AdCreative[]
  posts          OrgPost[]
  users          User[]

  @@index([type])
  @@index([verified])
}

model AdCampaign {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  objective        String
  budgetCents      BigInt
  dailyBudgetCents BigInt?
  startDate        DateTime
  endDate          DateTime
  status           String           @default("draft")
  targetingJson    String?
  impressions      BigInt           @default(0)
  clicks           BigInt           @default(0)
  conversions      BigInt           @default(0)
  spend            BigInt           @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  conversionValue  BigInt           @default(0)
  bids             AdBid[]
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatives        AdCreative[]
  dailyMetrics     AdMetricsDaily[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model AdCreative {
  id              String       @id @default(cuid())
  campaignId      String
  organizationId  String
  title           String
  description     String?
  mediaUrl        String?
  mediaType       String?
  callToAction    String
  landingUrl      String
  format          String
  impressions     BigInt       @default(0)
  clicks          BigInt       @default(0)
  conversions     BigInt       @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  interactiveData String?
  bids            AdBid[]
  campaign        AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([organizationId])
  @@index([deletedAt])
}

model AdMetricsDaily {
  id              String     @id @default(cuid())
  campaignId      String
  date            DateTime
  impressions     BigInt     @default(0)
  clicks          BigInt     @default(0)
  conversions     BigInt     @default(0)
  spendCents      BigInt     @default(0)
  cpm             Float?
  deletedAt       DateTime?
  conversionValue BigInt     @default(0)
  campaign        AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
  @@index([deletedAt])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  firstName      String?
  lastName       String?
  phone          String?
  score          Int       @default(0)
  tier           String    @default("cold")
  priceCents     Int       @default(0)
  explanation    String?
  status         String    @default("new")
  source         String?
  type           String?
  dataJson       String?
  feedbackJson   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([score])
  @@index([status])
  @@index([email])
  @@index([deletedAt])
}

model InteractiveAdEvent {
  id         String   @id @default(cuid())
  format     String
  type       String
  creativeId String?
  userId     String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([format])
  @@index([type])
  @@index([createdAt])
}

model InteractiveCreative {
  id        String   @id @default(cuid())
  type      String
  name      String
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([updatedAt])
}

model UserPropensity {
  id              String    @id @default(cuid())
  userId          String    @unique
  jobSeeking      Float     @default(0)
  courseInterest  Float     @default(0)
  spendingPower   Float     @default(0)
  engagementLevel Float     @default(0)
  churnRisk       Float     @default(0)
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([deletedAt])
}

model VideoAsset {
  id            String         @id @default(cuid())
  postId        String?
  title         String?
  description   String?
  originalUrl   String
  cdnUrl        String?
  duration      Int?
  width         Int?
  height        Int?
  format        String?
  status        String         @default("processing")
  captions      String?
  captionStatus String         @default("pending")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  variants      VideoVariant[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model VideoVariant {
  id        String     @id @default(cuid())
  videoId   String
  quality   String
  bitrate   String
  url       String
  fileSize  BigInt?
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  video     VideoAsset @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, quality])
  @@index([videoId])
  @@index([deletedAt])
}

model VideoProcessingQueue {
  id           String    @id @default(cuid())
  videoId      String    @unique
  status       String    @default("pending")
  priority     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([status])
  @@index([priority])
  @@index([deletedAt])
}

model OrgPost {
  id               String       @id @default(cuid())
  organizationId   String
  title            String?
  content          String
  mediaUrl         String?
  visibility       String       @default("public")
  type             String?
  tags             String[]     @default([])
  likes            Int          @default(0)
  comments         Int          @default(0)
  shares           Int          @default(0)
  watchTime        BigInt       @default(0)
  safetyScore      Float        @default(1.0)
  flaggedForReview Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model UserInteraction {
  id              String   @id @default(cuid())
  userId          String
  contentId       String
  actionType      String
  durationSeconds Int?
  timestamp       DateTime @default(now())

  @@index([userId])
  @@index([contentId])
  @@index([timestamp])
}

model ContentFeature {
  id               String   @id @default(cuid())
  contentId        String   @unique
  engagementRate   Float?
  watchTime        BigInt?
  recencyHours     Int?
  safetyScore      Float?
  creatorFollowers Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserFeature {
  id              String    @id @default(cuid())
  userId          String    @unique
  interests       String[]  @default([])
  activityScore   Float     @default(0.5)
  avgWatchSeconds Int?
  completionRate  Float?
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model FeedRanking {
  id          String   @id @default(cuid())
  userId      String
  postId      String
  rankScore   Float
  position    Int
  generatedAt DateTime @default(now())
  experiment  String?

  @@unique([userId, postId])
  @@index([userId, generatedAt])
}

model BanditArm {
  id          String   @id @default(cuid())
  contentId   String   @unique
  alpha       Float    @default(1.0)
  beta        Float    @default(1.0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RankingFeedback {
  id         String   @id @default(cuid())
  userId     String?
  postId     String
  bucket     String?
  experiment String?
  action     String
  reward     Float?
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([bucket])
  @@index([experiment, action])
}

model BidMultiplier {
  id         String  @id @default(cuid())
  campaignId String
  timeOfDay  String?
  device     String?
  location   String?
  quality    String?
  multiplier Float   @default(1.0)

  @@index([campaignId])
}

model AuctionLog {
  id                 String   @id @default(cuid())
  campaignId         String
  winnerId           String?
  winnerBid          Float
  secondHighestBid   Float?
  clearingPriceCents BigInt   @default(0)
  multiplierApplied  Float?
  contextJson        String?
  impressionId       String
  createdAt          DateTime @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

model SocialConversation {
  id        String          @id @default(cuid())
  name      String
  avatar    String?
  preview   String?
  lastSeen  String?
  unread    Int             @default(0)
  status    String          @default("offline")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  SocialMessage[]
}

model SocialMessage {
  id             String             @id @default(cuid())
  conversationId String
  sender         String
  body           String
  sentAt         DateTime           @default(now())
  isOwn          Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  tier                   SubscriptionTier
  status                 SubscriptionStatus @default(active)
  monthlyPrice           Int
  currency               String             @default("aud")
  stripeCustomerId       String?
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeProductId        String?
  defaultPaymentMethodId String?
  paymentMethodId        String?
  latestInvoiceId        String?
  latestInvoiceUrl       String?
  invoicePdfUrl          String?
  automaticTax           Boolean            @default(false)
  taxRatePercent         Float?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextBillingDate        DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  lastInvoiceAt          DateTime?
  churnRisk              Float              @default(0)
  lastInteractionAt      DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([status])
  @@index([stripeCustomerId])
}

model LiveStream {
  id              String    @id @default(cuid())
  creatorId       String
  title           String
  status          String    @default("scheduled")
  viewerCount     Int       @default(0)
  startedAt       DateTime?
  endedAt         DateTime?
  totalGifts      BigInt    @default(0)
  creatorEarnings BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([creatorId])
  @@index([status])
}

model GiftTransaction {
  id              String   @id @default(cuid())
  creatorId       String
  senderId        String
  giftType        String
  amount          Int
  valueCents      BigInt
  creatorEarnings BigInt
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([senderId])
}

model CreatorPayout {
  id          String   @id @default(cuid())
  creatorId   String
  totalAmount BigInt
  status      String   @default("pending")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Message {
  id            String    @id @default(cuid())
  senderId      String
  receiverId    String
  content       String
  messageType   String    @default("text")
  mediaUrl      String?
  mediaDuration Int?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  isEdited      Boolean   @default(false)
  editedAt      DateTime?
  canUnsend     Boolean   @default(true)
  unsentAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receiver      User      @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  actorId   String?
  relatedId String?
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AdAuction {
  id           String    @id @default(cuid())
  requestId    String    @unique
  placementId  String
  userId       String?
  winningBidId String?
  winningPrice BigInt?
  createdAt    DateTime  @default(now())
  bids         AdBid[]
  events       AdEvent[]

  @@index([createdAt])
}

model AdBid {
  id         String     @id @default(cuid())
  auctionId  String
  campaignId String
  creativeId String
  bidAmount  BigInt
  score      Float?
  isWinner   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  auction    AdAuction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative   AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([campaignId])
}

model AdEvent {
  id         String    @id @default(cuid())
  type       String
  auctionId  String?
  campaignId String
  creativeId String
  metadata   String?
  createdAt  DateTime  @default(now())
  auction    AdAuction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([campaignId])
  @@index([createdAt])
}

model AdAudience {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String
  ruleJson       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  members        AdAudienceMember[]

  @@index([organizationId])
}

model AdAudienceMember {
  id         String     @id @default(cuid())
  audienceId String
  userId     String
  createdAt  DateTime   @default(now())
  audience   AdAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@unique([audienceId, userId])
  @@index([userId])
}

model AdBillingAccount {
  id               String          @id @default(cuid())
  organizationId   String          @unique
  stripeCustomerId String?
  balanceCents     BigInt          @default(0)
  currency         String          @default("aud")
  billingThreshold BigInt          @default(50000)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id])
  invoices         AdInvoice[]
  transactions     AdTransaction[]
}

model AdInvoice {
  id               String           @id @default(cuid())
  billingAccountId String
  amountCents      BigInt
  status           String
  stripeInvoiceId  String?
  periodStart      DateTime
  periodEnd        DateTime
  pdfUrl           String?
  createdAt        DateTime         @default(now())
  paidAt           DateTime?
  billingAccount   AdBillingAccount @relation(fields: [billingAccountId], references: [id])

  @@index([billingAccountId])
  @@index([status])
}

model AdTransaction {
  id               String           @id @default(cuid())
  billingAccountId String
  type             String
  amountCents      BigInt
  description      String?
  stripeChargeId   String?
  createdAt        DateTime         @default(now())
  billingAccount   AdBillingAccount @relation(fields: [billingAccountId], references: [id])

  @@index([billingAccountId])
  @@index([type])
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  content       String?
  videoUrl      String?
  thumbnailUrl  String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  viewsCount    Int       @default(0)
  tags          String[]
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  comments      Comment[]
  likes         Like[]
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  videoViews    VideoView[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CreatorSubscription {
  id           String   @id @default(cuid())
  creatorId    String
  subscriberId String
  tier         String
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creator      User     @relation("CreatorSubs", fields: [creatorId], references: [id])
  subscriber   User     @relation("SubscriberSubs", fields: [subscriberId], references: [id])

  @@unique([creatorId, subscriberId])
}

enum UserRole {
  MEMBER
  COMPANY
  MENTOR
  TAFE
  REAL_ESTATE
  ADMIN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum SafetyStatus {
  SAFE
  AT_RISK
  FLAGGED
  UNDER_SUPPORT
}

enum SubscriptionTier {
  free
  premium
  premium_plus
  creator
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  incomplete
  incomplete_expired
  canceled
  paused
  unpaid
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0.0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("USD")
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  senderId    String
  receiverId  String
  postId      String?
  createdAt   DateTime @default(now())
  
  sender      User     @relation("SentTransactions", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedTransactions", fields: [receiverId], references: [id])
  post        Post?    @relation(fields: [postId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model VideoView {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  ipAddress String?
  userAgent String?
  viewedAt  DateTime @default(now())
  
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

enum TransactionType {
  TIP
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}



