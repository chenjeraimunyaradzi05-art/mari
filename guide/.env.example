DATABASE_URL=mysql://nextjs_user:nextjs_password@127.0.0.1:3306/nextjs_app
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000

# Storage
STORAGE_DRIVER=local # or 's3'
# S3 variables (if using STORAGE_DRIVER=s3)
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_S3_BASE_URL= # optional custom base URL

# LLM provider and default model
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4.5
# Optional: force a specific model for all clients (e.g., claude-sonnet-4.5)
FORCE_LLM_MODEL=
