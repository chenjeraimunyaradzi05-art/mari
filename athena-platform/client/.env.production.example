# ===========================================
# ATHENA CLIENT - PRODUCTION (Netlify)
# ===========================================
# Copy these to your Netlify Environment Variables

# Backend API URL (your production backend)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# App URL
NEXT_PUBLIC_APP_URL=https://your-app.netlify.app

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false

# Stripe.js in the browser: the publishable key only (pk_live_...). Card
# details are entered in Stripe's own elements and never reach the app.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
