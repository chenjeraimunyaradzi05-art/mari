# ===========================================
# ATHENA CLIENT — NETLIFY PRODUCTION ENV VARS
# ===========================================
# Set these in Netlify Dashboard → Site Settings → Environment Variables
# Do NOT commit actual values to git.

# ===========================================
# REQUIRED
# ===========================================

# [REQUIRED] Your backend API URL (all API calls proxy here)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# [REQUIRED] This site's public URL
NEXT_PUBLIC_APP_URL=https://athena-empress.netlify.app

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ===========================================
# ERROR TRACKING — Sentry
# ===========================================
# [RECOMMENDED] Get from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=athena-client

# ===========================================
# ANALYTICS — PostHog (optional)
# ===========================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# PAYMENTS — Stripe (client-side publishable key)
# ===========================================
# [RECOMMENDED] Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
