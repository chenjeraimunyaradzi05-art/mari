# ===========================================
# ATHENA CLIENT ENVIRONMENT VARIABLES
# ===========================================
# For Netlify: set these in Netlify Dashboard → Site Settings → Environment Variables

# API Backend URL (production backend URL or localhost for dev)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production example: NEXT_PUBLIC_API_URL=https://api.your-domain.com

# App URL (this client's public URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: NEXT_PUBLIC_APP_URL=https://YOUR-APP.netlify.app

# Server-only (no NEXT_PUBLIC_ prefix). The route handlers under app/api proxy
# every browser call to the API and forward the visitor's address with this
# secret; the API believes the address only when it matches its own
# PROXY_SHARED_SECRET. Same value on both hosts. Without it the API sees every
# visitor as this host, so rate limits and the login lockout are shared by all.
PROXY_SHARED_SECRET=

# App metadata
NEXT_PUBLIC_APP_NAME=ATHENA

# The host member media is served from: the same host as the API's CDN_URL (a
# host name such as cdn.example.org, or a URL). next/image only loads images
# from hosts it has been told about, so without it avatars on the feed are
# refused in production. Read at build time. Leave empty in development.
NEXT_PUBLIC_MEDIA_HOST=

# Sentry (Error Tracking)
# The DSN is read at build time (NEXT_PUBLIC_), so set it and then deploy again.
# SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN are for the build only: they
# let it upload source maps, so a production error shows the line in the source
# and not a line in a minified file. The token is a secret (Sentry > Settings >
# Auth Tokens, an organisation token); never give it a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Contact and legal identity
#
# Until NEXT_PUBLIC_CONTACT_DOMAIN is set, the app publishes NO email addresses
# and every contact point resolves to an in-product route instead. This is
# deliberate: the app previously published privacy@ and dpo@ addresses on a
# domain ATHENA does not own, which would have sent data-subject requests to a
# third party. Set this only to a domain you actually control.
NEXT_PUBLIC_CONTACT_DOMAIN=

# Australian company details, published in the terms and privacy policy. Left
# blank they render as "to be published before public launch" rather than a
# fabricated value. Both are required before taking payment from the public.
NEXT_PUBLIC_ORG_ABN=
NEXT_PUBLIC_ORG_ACN=
NEXT_PUBLIC_ORG_ADDRESS=
