# ===========================================
# ATHENA CLIENT ENVIRONMENT VARIABLES
# ===========================================
# For Netlify: set these in Netlify Dashboard → Site Settings → Environment Variables

# API Backend URL (Railway production URL or localhost for dev)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production example: NEXT_PUBLIC_API_URL=https://YOUR-SERVER.up.railway.app

# App URL (this client's public URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: NEXT_PUBLIC_APP_URL=https://YOUR-APP.netlify.app

# App metadata
NEXT_PUBLIC_APP_NAME=ATHENA

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
