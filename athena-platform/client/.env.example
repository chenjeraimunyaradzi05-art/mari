# ===========================================
# ATHENA CLIENT ENVIRONMENT VARIABLES
# ===========================================
# For Netlify: set these in Netlify Dashboard → Site Settings → Environment Variables

# API Backend URL (production backend URL or localhost for dev)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production example: NEXT_PUBLIC_API_URL=https://api.your-domain.com

# App URL (this client's public URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: NEXT_PUBLIC_APP_URL=https://YOUR-APP.netlify.app

# App metadata
NEXT_PUBLIC_APP_NAME=ATHENA

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Contact and legal identity
#
# Until NEXT_PUBLIC_CONTACT_DOMAIN is set, the app publishes NO email addresses
# and every contact point resolves to an in-product route instead. This is
# deliberate: the app previously published privacy@ and dpo@ addresses on a
# domain ATHENA does not own, which would have sent data-subject requests to a
# third party. Set this only to a domain you actually control.
NEXT_PUBLIC_CONTACT_DOMAIN=

# Australian company details, published in the terms and privacy policy. Left
# blank they render as "to be published before public launch" rather than a
# fabricated value. Both are required before taking payment from the public.
NEXT_PUBLIC_ORG_ABN=
NEXT_PUBLIC_ORG_ACN=
NEXT_PUBLIC_ORG_ADDRESS=
