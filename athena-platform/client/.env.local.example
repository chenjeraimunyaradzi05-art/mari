# ===========================================
# ATHENA CLIENT ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# Backend API URL (required)
# In development: your local server
# In production: your backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional explicit realtime origin (defaults to NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# This app's public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In (optional — social login)
# Create a Web application OAuth client in Google Cloud Console
# Authorized JavaScript origins should include http://localhost:3000
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Facebook Sign-In (optional — social login)
# Create an app at https://developers.facebook.com → Add "Facebook Login" product.
# Add http://localhost:3000 to "Valid OAuth Redirect URIs" and
# "Allowed Domains for the JavaScript SDK". Use Live mode for production.
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ===========================================
# ERROR TRACKING (Sentry)
# ===========================================
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# ===========================================
# ANALYTICS (PostHog)
# ===========================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# STRIPE (Client-side publishable key)
# ===========================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
