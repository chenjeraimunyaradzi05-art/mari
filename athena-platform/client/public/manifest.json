{
  "name": "ATHENA",
  "short_name": "ATHENA",
  "description": "The Career SuperApp - Your all-in-one platform for professional growth, networking, and opportunities",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#020617",
  "theme_color": "#020617",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "education", "social", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Feed",
      "short_name": "Feed",
      "description": "View the public ATHENA feed",
      "url": "/feed",
      "icons": [{ "src": "/logo.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "description": "Browse job opportunities",
      "url": "/jobs",
      "icons": [{ "src": "/logo.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "description": "Open career video and content discovery",
      "url": "/explore",
      "icons": [{ "src": "/logo.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Mentors",
      "short_name": "Mentors",
      "description": "Browse mentors and career guidance",
      "url": "/mentors",
      "icons": [{ "src": "/logo.png", "sizes": "512x512", "type": "image/png" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"]
}
