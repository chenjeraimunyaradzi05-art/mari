# ===========================================
# ATHENA SERVER - PRODUCTION ENVIRONMENT
# ===========================================
# Set these on the API host (any always-on Node 20 host; see
# DEPLOYMENT_GUIDE.md). The database is Neon; the web app is on Netlify and
# holds none of these. Every variable below is read by the server; the
# obsolete ones that nothing read have been removed.
#
# 1. Copy the values you need into the host's environment settings
# 2. Replace ALL placeholder values with real credentials
# 3. Never commit this file with real values to git
# ===========================================

# -------------------------------------------
# APPLICATION
# -------------------------------------------
NODE_ENV=production
# Most hosts inject PORT themselves; the server defaults to 5000.
PORT=5000

# This service's public URL. Used for email links, webhook URLs and CORS.
APP_URL=https://api.your-domain.com
API_URL=https://api.your-domain.com

# The Netlify site. CLIENT_URL and FRONTEND_URL must match.
CLIENT_URL=https://athena-empress.netlify.app
FRONTEND_URL=https://athena-empress.netlify.app

# Comma-separated origins allowed by CORS and Socket.IO.
ALLOWED_ORIGINS=https://athena-empress.netlify.app
# Set true to also allow Netlify deploy-preview origins (*.netlify.app).
CORS_ALLOW_PREVIEW_ORIGINS=false

# Graceful shutdown: how long to drain in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

# -------------------------------------------
# DATABASE (Neon PostgreSQL) - see NEON_SETUP.md
# -------------------------------------------
# DATABASE_URL is the POOLED endpoint (hostname contains "-pooler") for
# runtime traffic. DIRECT_DATABASE_URL is the DIRECT endpoint for Prisma
# migrations, which start.ts runs at boot. Both need sslmode=require; the
# server refuses to start in production on a Neon URL without it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15&pool_timeout=15
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15

# -------------------------------------------
# REDIS (caching, job queues, event bus)
# -------------------------------------------
# Optional. Without it caching is disabled and workers cannot start.
# Hosted options: Upstash, Redis Cloud. Format: redis://[:password@]host:port
REDIS_URL=redis://default:password@host:6379

# -------------------------------------------
# BACKGROUND WORKERS (BullMQ)
# -------------------------------------------
# Set ENABLE_WORKERS=true only after REDIS_URL and the video processor are
# provisioned. The worker process validates them before opening Redis.
# Push notifications and data exports run inside the worker itself.
ENABLE_WORKERS=true
WORKER_CONCURRENCY=5
WORKER_STARTUP_TIMEOUT_MS=30000
WORKER_ALLOW_SIMULATION=false
VIDEO_PROCESSING_ALLOW_SIMULATION=false
VIDEO_ALLOW_SIMULATION=false
VIDEO_PROCESSOR_URL=https://video-processor.your-domain.com
# Optional overrides: hand push or export jobs to an external service you
# already run. Leave unset to deliver in process.
# PUSH_NOTIFICATION_PROVIDER_URL=
# DATA_EXPORT_PROCESSOR_URL=

# Recurring jobs. The data-retention purge runs overnight in this timezone
# (defaults: 03:00, Australia/Brisbane).
DATA_RETENTION_CRON=0 3 * * *
SCHEDULER_TIMEZONE=Australia/Brisbane

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------
# CRITICAL: a random string of at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie SameSite policy. "lax" is right when the web app and
# the API are on different hosts, which they are.
COOKIE_SAMESITE=lax

# Login lockout: after LOGIN_MAX_FAILURES within the window, lock for the
# duration.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_DURATION_SECONDS=900

# Social sign-in (optional). Each must match its NEXT_PUBLIC_* twin on the
# web app.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -------------------------------------------
# EMAIL (SendGrid)
# -------------------------------------------
# Both are required: in production the API refuses to start without a SendGrid
# key and a sender address, because nobody can verify an account without a
# verification email. The sender must be on a domain you own and have
# authenticated in SendGrid; athena.com and example.com are refused.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@your-domain.com
# The verification key SendGrid shows when you switch on the Signed Event
# Webhook (Settings > Mail Settings > Event Webhook, pointed at
# https://<api-host>/api/webhooks/sendgrid with Bounced, Dropped and Spam
# Reports ticked). Without it an address that bounces keeps being mailed, and
# the endpoint answers 503.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Where safety and incident mail goes. Use addresses on a domain you own.
TRUST_SAFETY_EMAIL=trust-safety@your-domain.com
AUTHORITY_ESCALATION_EMAIL=
INCIDENT_TEAM_EMAILS=

# -------------------------------------------
# PAYMENTS (Stripe)
# -------------------------------------------
# Use LIVE keys in production (sk_live_).
STRIPE_SECRET_KEY=
# Webhook endpoint: https://api.your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# The second endpoint, with "Listen to events on Connected accounts" ticked, has
# its own signing secret. payout.paid, payout.failed and account.updated arrive
# there and are refused without it, so a seller whose payout bounced, or whose
# account Stripe stopped paying, is told nothing.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Leave unset until docs/runbooks/STRIPE-CONNECT.md has been walked in test mode.
# 'manual' creates new connected accounts on a manual payout schedule, so a
# member's balance waits until she presses Withdraw instead of Stripe sweeping it
# to her bank on its own schedule. Only accounts created after it is set change.
# STRIPE_CONNECT_PAYOUT_SCHEDULE=manual
# Never true in production: a process with it on will not start. It would let a
# business registration be marked paid with no charge.
ALLOW_STRIPE_SIMULATION=false

# Who ATHENA is on an invoice. The legal name, ABN, billing address and billing
# email have no default, and no invoice document is produced until all four are
# set (a member's download answers 503, and /health/launch-readiness fails in
# production). The ABN must pass its checksum and the billing email must be on a
# domain ATHENA owns. Billing address lines are separated by |. The registration
# date is optional: set it only once ATHENA is registered for GST (the ATO
# threshold is A$75,000 a year); "Tax invoice" and "includes GST" are said only
# when the ABN passes its checksum and the date has arrived.
ATHENA_LEGAL_NAME=
ATHENA_ABN=
ATHENA_GST_REGISTERED_FROM=
ATHENA_BILLING_ADDRESS=
ATHENA_BILLING_EMAIL=

# Subscription price IDs from Stripe Dashboard -> Products. One per tier;
# add a currency suffix (e.g. STRIPE_PRICE_CAREER_USD) for per-currency
# prices, falling back to the unsuffixed one.
STRIPE_PRICE_CAREER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTREPRENEUR=price_xxxxx
STRIPE_PRICE_CREATOR=price_xxxxx

# -------------------------------------------
# AI (OpenAI)
# -------------------------------------------
OPENAI_API_KEY=
AI_OPENAI_API_KEY=
AI_OPENAI_ORG=
AI_OPENAI_CHAT_MODEL=gpt-4o
# Never true in production: answers with canned text instead of calling the model.
AI_ALLOW_SIMULATION=false
AI_CHAT_FREE_MAX_REQUESTS=10
AI_CHAT_FREE_WINDOW_SECONDS=3600
AI_SOCIAL_CONTENT_ENABLED=true

# Optional ML service (recommendations); leave unset to disable.
ML_SERVICE_URL=
# false keeps the ML service for predictions but ranks the feed by engagement only
ML_FEED_RANKING=true
ML_SERVICE_TIMEOUT=30000

# -------------------------------------------
# FILE STORAGE (AWS S3)
# -------------------------------------------
# Required in production: the API refuses to start without all three of
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and S3_BUCKET, in the shape AWS
# issues them. A container's disk does not survive a deploy, so nothing a member
# uploads is ever written to it in production. The bucket is in ap-southeast-2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=athena-uploads-prod
# All media goes to S3_BUCKET. The S3_MEDIA_BUCKET, S3_UPLOADS_BUCKET,
# S3_EXPORTS_BUCKET and S3_BACKUPS_BUCKET entries that used to follow were read
# by nothing; the nightly database copy is a GitHub workflow, not the API.
#
# The CDN in front of the media bucket, as the https address it is served from.
# Required: the process does not start without it (src/utils/env.ts), because a
# public file is stored as `${CDN_URL}/key` and the bucket's own address, the
# fallback, answers 403 with Block Public Access on. It carries the public folders
# only (avatars, covers, posts, videos, thumbnails, captions, sounds). Résumés,
# documents and files sent in a conversation are private: addressed at the bucket
# and read through the API by a five-minute signed link. The bucket keeps Block
# Public Access on; GET /health/launch-readiness?probe=media (with
# HEALTH_DIAGNOSTICS_TOKEN) proves it, and infrastructure/README.md ("Media
# bucket") has the policy. Not the bucket's own amazonaws.com address.
CDN_URL=

# Malware scanning. Every upload is looked inside by ClamAV, which runs as a
# service of its own (clamav/clamav, about 2 GB, port 3310): this is where it
# is. Without it a résumé or a document is refused and /health/launch-readiness
# answers not_ready. DEPLOY.md ("Malware scanning") says how to run it.
# MALWARE_SCAN_REQUIRED is left empty on purpose: in production that means
# "documents" (résumés and documents are refused when they cannot be scanned);
# "all" refuses every unscanned upload and "off" decides not to scan at all.
CLAMAV_HOST=
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=

# Optional: load secrets from AWS Secrets Manager instead of the environment.
USE_AWS_SECRETS=false
AWS_SECRET_NAME=

# -------------------------------------------
# PUSH NOTIFICATIONS
# -------------------------------------------
# The mobile app registers Expo push tokens and they are delivered through
# Expo's push API with no further setup. Set EXPO_ACCESS_TOKEN only if the
# Expo project has enhanced push security turned on.
EXPO_ACCESS_TOKEN=
# Firebase Cloud Messaging, optional, for non-Expo tokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -------------------------------------------
# SEARCH (OpenSearch, optional)
# -------------------------------------------
# Leave disabled to use the Prisma search fallback.
OPENSEARCH_ENABLED=false
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# -------------------------------------------
# SECURITY AND OPERATIONS
# -------------------------------------------
# Production ignores RATE_LIMIT_ENABLED=false: the limits cannot be switched off there.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
# The budget per window for an address with no valid access token. A signed-in
# member has her own, RATE_LIMIT_MEMBER_MAX (1500), and staff
# RATE_LIMIT_STAFF_MAX (5000); leave those unset to take the defaults.
RATE_LIMIT_MAX=100
# Per ten minutes, per account (per address for a visitor), for the reads that
# add up to a copy of the membership: PROFILE_READ_MAX (120, a member's page and
# her follower lists), MEMBER_SEARCH_MAX (200) and DIRECTORY_READ_MAX (300, the
# mentor and job directories). Leave unset to take the defaults.
# What a visitor with no account may read of a member: "card" (name, picture,
# headline, counts; the default) or "full" (the whole public profile). A privacy
# decision for the owner; docs/runbooks/ONCALL.md ("High 429 rate") says more.
PUBLIC_PROFILE_DETAIL=card

# Protects /metrics. Generate with: openssl rand -hex 32
METRICS_TOKEN=
# Protects /health/auth-diag and the other diagnostic health routes.
HEALTH_DIAGNOSTICS_TOKEN=

# 64 hex characters (AES-256). Seals safe-chat messages, health records, safety
# plans and two-factor seeds. Generate with: openssl rand -hex 32. Back it up
# somewhere the API host cannot take with it; changing it is a rotation, see
# docs/runbooks/ENCRYPTION.md. Production refuses all zeros, a placeholder or a
# repeating pattern.
DV_ENCRYPTION_KEY=

# -------------------------------------------
# ERROR TRACKING (Sentry, optional)
# -------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Live streaming (optional). With neither set, a host pastes the playback URL
# of a stream they run elsewhere; chat, viewer counts and gifts work either way.
# LIVESTREAM_RTMP_INGEST_URL=rtmp://ingest.example.com/live
# LIVESTREAM_PLAYBACK_URL_TEMPLATE=https://cdn.example.com/hls/{streamKey}/index.m3u8
# Shared secret an RTMP server presents to /api/livestream/key/validate and
# /api/livestream/webhooks/rtmp (header x-livestream-secret).
# LIVESTREAM_WEBHOOK_SECRET=

# Video processing runs ffmpeg (ffmpeg-static) on this host. Set to off only on
# a host with no scratch disk; reels are then published as uploaded.
# VIDEO_PIPELINE=on
