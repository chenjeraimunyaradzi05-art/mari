# ===========================================
# ATHENA SERVER ENVIRONMENT VARIABLES
# ===========================================

# Application
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# There is no TRUST_PROXY setting. This file used to offer TRUST_PROXY=false,
# and nothing read it: index.ts trusts exactly one proxy hop, which is what
# Render, Fly and the Netlify route handlers put in front of the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# The web app's route handlers proxy every browser call to this API from their
# own addresses. They forward the visitor's address in X-Athena-Client-Ip with
# this secret in X-Athena-Proxy-Secret, and the API believes the address only
# when the secret matches. Set the same value on the web host (Netlify env).
# Without it every visitor shares the proxy's address for rate limits, the
# login lockout and new-device alerts. 32+ characters: openssl rand -hex 32
PROXY_SHARED_SECRET=
SHUTDOWN_TIMEOUT_MS=10000

# Production deployment URLs
# NETLIFY_URL=https://your-app.netlify.app
# DEPLOY_URL=https://api.your-domain.com

# Database (PostgreSQL)
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athena_dev"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athena_dev"
# Neon production:
# DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/athena_prod?sslmode=require&channel_binding=require&connect_timeout=15&pool_timeout=15"
# DIRECT_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/athena_prod?sslmode=require&channel_binding=require&connect_timeout=15"

# Redis
REDIS_URL="redis://localhost:6379"

# ===========================================
# ML SERVICE
# ===========================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30000
# Shared key the API sends as X-ML-Key; set the same value on the ML service so nothing else can call it.
ML_SERVICE_KEY=
# The feed is re-ranked by the ML service when ML_SERVICE_URL is set; false keeps the engagement ranker only.
ML_FEED_RANKING=true

# ===========================================
# OPENSEARCH (Full-text Search)
# ===========================================
OPENSEARCH_NODE=http://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=admin

# JWT Authentication
# Production refuses to start with this placeholder, or anything short or
# repeating. Generate a real one: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
# The key the list of banned people is hashed with. Leave empty locally. In
# production set it once (openssl rand -hex 32), so rotating JWT_SECRET cannot
# unban anyone; docs/runbooks/ONCALL.md has the steps for a platform that
# already has bans.
BANNED_IDENTITY_HASH_KEY=
# Access tokens are bearer tokens; keep them short. The clients refresh on the
# first 401, and the refresh token rotates on every use. These are the defaults
# and the values render.yaml and fly.toml deploy.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# The refresh cookie's SameSite. The browser only ever calls this API through
# the web app's own route handlers (same site), so "lax" holds and a page on
# another site cannot POST the cookie to /api/auth/refresh. Set "none" only
# for a deployment where the browser calls the API origin directly.
COOKIE_SAMESITE=lax
# Authenticator (TOTP) secrets are encrypted at rest under this key; when it is
# unset the DV key below is used. 64 hex characters: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Human check on password sign-up (Cloudflare Turnstile).
# Enforced only when this is set; a production server without it logs one
# warning at start and /health/launch-readiness reports it. It is configured
# together with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the web host, from the same
# Turnstile widget: the site key alone shows a widget nobody checks, and the
# secret alone refuses every password sign-up, because the form never sends a
# token.
TURNSTILE_SECRET_KEY=

# Where a completed women-only check (a reviewer has approved her) is asked for,
# on top of the floor every write already has (an account a reviewer refused
# cannot act). A comma-separated list of: private_groups, creator_payouts, or
# all. Empty means only the surfaces that are always enforced (mentor
# publication, confidential housing) ask for it. Leave it empty until someone is
# reviewing requests: turning a surface on before then shuts every member who
# has not been reviewed out of it. See docs/security/authorisation-matrix.md.
WOMAN_VERIFIED_REQUIRED_FOR=

# There is no Auth0 or other SSO integration; the AUTH0_* entries that used to
# sit here were read by nothing. Social sign-in is Google and Facebook, below.

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# The signing secret of the SECOND webhook endpoint, the one Stripe sends
# Connect (connected-account) events to: payout.paid, payout.failed and
# account.updated. Without it those events are refused and a seller whose
# payout failed, or whose account Stripe stopped paying, is told nothing
# (routes/webhook.routes.ts).
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret
# 'manual' creates new connected accounts on a manual payout schedule, so a
# balance waits until the member presses Withdraw. Decided in test mode:
# docs/runbooks/STRIPE-CONNECT.md. Unset leaves Stripe's own schedule.
# STRIPE_CONNECT_PAYOUT_SCHEDULE=manual
# Never true in production (the process will not start). Development only.
ALLOW_STRIPE_SIMULATION=false
# Stripe Price IDs (per tier, per currency)
STRIPE_PRICE_CAREER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTREPRENEUR=price_xxxxx
STRIPE_PRICE_CREATOR=price_xxxxx
# Add regional price IDs as needed: STRIPE_PRICE_CAREER_USD, STRIPE_PRICE_CAREER_GBP, etc.
# Create each price in Stripe as AUD with tax behaviour "Inclusive": the amount a
# member sees is the amount she pays, and the GST on her tax invoice is worked out
# from it as one eleventh (services/invoice.service.ts). A price set up as tax
# "Exclusive" would make the invoice say GST was in a total that did not include it.

# Who ATHENA is on an invoice (services/invoice.service.ts). The legal name, ABN,
# billing address and billing email have no default, and no invoice document is
# produced until all four are set: a member's download answers 503. The invoices
# themselves are filed as sales happen and keep, so nothing is lost by setting
# them late. The ABN must pass its checksum, the billing address lines are
# separated by |, and the billing email must be a mailbox on a domain ATHENA owns.
# ATHENA_GST_REGISTERED_FROM (YYYY-MM-DD, the date registration took effect) is
# optional: set it only once ATHENA is registered for GST (the ATO threshold is
# A$75,000 a year turnover; optional before). "Tax invoice" and "includes GST" are
# said only when the ABN passes its checksum AND that date has arrived; until then
# a document is an "Invoice" that says no GST was charged, and the price pages say
# the same.
ATHENA_LEGAL_NAME=
ATHENA_ABN=
ATHENA_GST_REGISTERED_FROM=
ATHENA_BILLING_ADDRESS=
ATHENA_BILLING_EMAIL=

# Card holds behind marketplace orders and car purchases (services/escrow-expiry.service.ts,
# services/stripe-connect.service.ts). A card hold lasts about a week.
# Take the money early, before a hold lapses, for work its own flow records as
# done (a delivered order, a finished session). Off: money leaves a card only when
# the buyer or staff release it. Decide this with the owner before turning it on.
ESCROW_CAPTURE_BEFORE_EXPIRY=false
# Ask the card network for a longer authorisation where the account and the card
# are eligible ("if_available" never fails a payment). Ask Stripe support whether
# it is available to this account, and what it costs, before turning it on. The
# deadline Stripe actually grants is read back from the charge and kept on the hold.
ESCROW_REQUEST_EXTENDED_AUTHORISATION=false

# Creator payouts (services/creator-payout-sweeper.service.ts). Leave this unset
# and a creator is paid when she asks, once her balance reaches the minimum, which is
# what section 5.3 of the Terms says. Set it to "monthly" and on the 1st of each
# month, Queensland time, every creator at or above the minimum is paid without
# asking, through the same checks as her own request. Do not turn it on until the
# owner has decided it and section 5.3 and the Creator Terms Addendum say the same.
CREATOR_AUTO_PAYOUTS=

# OpenAI / AI
OPENAI_API_KEY=sk-your-openai-api-key
AI_OPENAI_API_KEY=sk-your-openai-api-key
AI_OPENAI_ORG=
AI_OPENAI_CHAT_MODEL=gpt-4o
AI_ALLOW_SIMULATION=false
# Chat requests per window, by tier. The values below are the defaults the code
# uses when these are unset (ai.routes.ts). The free tier here used to read 10
# an hour, which is 240 a day and twelve times the default it was overriding.
AI_CHAT_FREE_MAX_REQUESTS=20
AI_CHAT_FREE_WINDOW_SECONDS=86400
AI_CHAT_PREMIUM_MAX_REQUESTS=200
AI_CHAT_PREMIUM_WINDOW_SECONDS=86400
# Model tokens per UTC day (ai-budget.service.ts). Once a member has used her
# share the AI routes answer her 429, and once the platform has used its day
# they answer everyone 503, until the UTC day turns over (10am in Brisbane).
# Set the global figure to what the OpenAI account can actually carry.
AI_DAILY_TOKENS_PER_MEMBER=250000
AI_DAILY_TOKENS_GLOBAL=20000000
AI_SOCIAL_CONTENT_ENABLED=true
# The 0-100 ranking score a post gets when no model has read it. A fraction up
# to 1 is also read as a share of 100, so 0.5 means 50; it used to be read as 0.
AI_SOCIAL_FALLBACK_SCORE=50
AI_SOCIAL_MAX_TAGS=5

# Social Sign-In (optional)
# Google: server-side verifies the ID token "aud" claim — must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the client.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Facebook: server-side uses the App ID + App Secret to build the app access token and validate user tokens via debug_token.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# AWS S3 (media storage)
# Leave the two keys empty on a development machine and uploads are stored in
# ./uploads and served by this API at /uploads.
#
# In production all three of AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# S3_BUCKET are required and format-checked at boot (src/utils/env.ts), and the
# process refuses to start without them. That includes the placeholder values
# this file used to carry: they are not the shape of a real key, and they are
# refused on purpose, because a deployment that started with them wrote every
# avatar, post image, résumé and reel to a container disk the next deploy
# wipes. At start the API also asks S3 whether the bucket answers; the reading
# is on /health/detailed (media-storage.s3-unreachable) and
# /health/launch-readiness fails while it does not.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=athena-uploads-dev
# All media goes to S3_BUCKET. The S3_MEDIA_BUCKET, S3_UPLOADS_BUCKET,
# S3_EXPORTS_BUCKET and S3_BACKUPS_BUCKET entries that used to follow were read
# by nothing, and the last of them suggested backups existed when none did.
#
# The API takes no part in backups and holds none of their settings. The
# nightly off-platform copy is .github/workflows/backup.yml, configured in the
# repository's production-backups environment; it does nothing until that is
# set up. athena-platform/docs/runbooks/ONCALL.md ("Backups and restore") says
# what it does, what the owner has to decide first, and how to restore.
#
# BACKUP_AWS_REGIONS is the one backup-related value the API reads, and only to
# say where copies are held: GET /api/compliance/data-transfers lists these
# regions (comma-separated AWS region codes) as backup locations. Set it to the
# backup bucket's region once the copies exist; left empty, the disclosure
# names no backup location, which is the truth until then.
BACKUP_AWS_REGIONS=

# AWS Secrets Manager (optional)
USE_AWS_SECRETS=false
AWS_SECRET_NAME=athena/production

# ===========================================
# CDN (Content Delivery)
# ===========================================
# The address media stored in S3 is served from. It is written into the row
# with every upload, so set it only to a CDN you have put in front of
# S3_BUCKET; left empty, the bucket's own address is used, which is fine on a
# developer's machine and refused in production (src/utils/env.ts), where the
# bucket keeps Block Public Access on and its own address answers 403. This
# used to ship as https://cdn.athena.app, a host nothing here provisions. There
# is no CloudFront URL signing, so the CLOUDFRONT_* entries were read by nothing.
#
# Only the public folders go through it: avatars, covers, posts, videos,
# thumbnails, captions and sounds. Résumés, documents and files sent in a
# conversation (resumes/, documents/ and chat/) are private: they are addressed
# at the bucket, never here, and are read only through the API, by a signed
# link that lives five minutes. So the CDN must be allowed to fetch the public
# folders and nothing else, and the bucket keeps Block Public Access on.
# GET /health/launch-readiness?probe=media (with the diagnostics token) proves it from the
# outside; infrastructure/README.md ("Media bucket") has the policy.
CDN_URL=

# ===========================================
# Malware scanning (ClamAV)
# ===========================================
# Every upload is looked inside by ClamAV before it is kept
# (src/services/malware-scan.service.ts). ClamAV runs as a service of its own
# (the clamav/clamav image, about 2 GB of memory, port 3310); this is where it is.
# Left empty, no scanner is asked: in development that is fine, and in production
# a résumé or a document is refused until it is set, because they are the files
# that are stored as sent and opened by somebody else. DEPLOY.md ("Malware
# scanning") says how to run it. For a local one:
#   docker run -d -p 3310:3310 --name clamav clamav/clamav:stable
CLAMAV_HOST=
CLAMAV_PORT=3310
# What happens to a file that cannot be scanned (no scanner, not reachable, too
# slow, or too large). A file the scanner finds a virus in is refused whatever
# this says.
#   documents  résumés and documents are refused, a PDF or Word file sent in a
#              conversation among them; pictures and video are stored. The
#              default in production: pictures are rewritten and video is
#              re-encoded on the way in, which removes what they can carry.
#   all        every upload is refused when it cannot be scanned.
#   off        nothing is refused for want of a scanner. A decision, made on
#              purpose. The default outside production.
MALWARE_SCAN_REQUIRED=
# The largest file handed to the scanner, in bytes (default 26214400, 25 MB:
# clamd's own StreamMaxLength). Raise both together to scan reels.
MALWARE_SCAN_MAX_BYTES=
# How long a scan may take before it counts as unavailable (default 60000).
MALWARE_SCAN_TIMEOUT_MS=

# SendGrid (Email)
# Production will not start without both. The sender has no default: use an
# address on a domain you own and have authenticated in SendGrid (Settings >
# Sender Authentication). athena.com and example.com are refused.
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com
# Optional. The verification key SendGrid shows when you switch on the Signed
# Event Webhook (Settings > Mail Settings > Event Webhook, pointed at
# https://<api-host>/api/webhooks/sendgrid with Bounced, Dropped and Spam
# Reports ticked). With it, an address SendGrid says cannot be reached stops
# being mailed. Without it the endpoint answers 503 and nothing is suppressed.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Panic-button SMS (optional). All three must be set together or the SMS
# channel stays off and the panic button falls back to email only — which is
# what it did before this existed. The mobile emergency-contact form collects
# an email precisely because email is the channel that always works.
# Check the Twilio account has geographic permission for +61 before relying on it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===========================================
# PUSH NOTIFICATIONS (Firebase, optional)
# ===========================================
# Mobile push goes through Expo and needs none of these. Setting
# FIREBASE_PROJECT_ID turns the Firebase path on, so it is left empty rather
# than filled with a placeholder the code would try to sign in with.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Video is transcoded in this process with ffmpeg, or by VIDEO_PROCESSOR_URL
# when the workers are on (see BACKGROUND WORKERS). There is no Mux
# integration; the MUX_* entries that used to sit here were read by nothing.

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
# Staff roles (moderator, admin) must have two-factor enrolled before their powers work.
# Always on in production; set to false only for local work.
STAFF_TWO_FACTOR_REQUIRED=true
RATE_LIMIT_WINDOW_MS=900000
# Calls per window for an address with no valid access token. A signed-in member
# has a budget of her own, RATE_LIMIT_MEMBER_MAX (default 1500), counted under
# her account on whatever address; staff have RATE_LIMIT_STAFF_MAX (default
# 5000). Outside production all three are relaxed unless set here.
RATE_LIMIT_MAX=100
# Budgets for the reads that, added up, are a copy of the membership. Each is
# per ten minutes and counted per account (per address for a visitor with no
# account); leave unset for the defaults. A woman opening profiles one after
# another does about twelve a minute at the very most.
#   PROFILE_READ_MAX=120     a member's page, and her follower and following lists
#   MEMBER_SEARCH_MAX=200    member search, for a signed-in member
#   DIRECTORY_READ_MAX=300   the mentor and job directories
# What a visitor with no account may read of a member. "card" (the default) is
# her name, picture, headline and counts; she signs in for the rest. "full" is
# the whole public profile for anyone, as it was before this setting existed. A
# privacy decision for the owner, not a tuning knob.
PUBLIC_PROFILE_DETAIL=card

# ===========================================
# BACKGROUND WORKERS
# ===========================================
ENABLE_WORKERS=true
WORKER_CONCURRENCY=5
# Production worker provider URLs (required when ENABLE_WORKERS=true and simulation is disabled)
# VIDEO_PROCESSOR_URL=https://video-processor.example.com
# Push and data export run in process; these two hand them to an external
# service instead and are optional.
# PUSH_NOTIFICATION_PROVIDER_URL=https://push-provider.example.com
# DATA_EXPORT_PROCESSOR_URL=https://data-export.example.com
# EXPO_ACCESS_TOKEN=
# VIDEO_ALLOW_SIMULATION=false
# WORKER_ALLOW_SIMULATION=false
# VIDEO_PROCESSING_ALLOW_SIMULATION=false

# ===========================================
# METRICS
# ===========================================
METRICS_TOKEN=your_metrics_token
# The log level follows NODE_ENV: debug in development, info in production,
# errors only under test (src/utils/logger.ts). There is no LOG_LEVEL setting.

# ===========================================
# ENCRYPTION AT REST
# ===========================================
# 64 hex characters (AES-256): openssl rand -hex 32
# This one key seals safe-chat messages, health records, authenticator seeds and
# members' safety plans. Leave it empty locally: a built-in development key is
# used, which anyone can read in the source. Production refuses to start without
# a real one, and refuses all zeros, a placeholder or a repeating pattern, so
# there is deliberately no example value here to copy.
# Back it up somewhere the API host cannot take with it: without this exact
# value that data cannot be read again. Changing it is a rotation, not an edit:
# docs/runbooks/ENCRYPTION.md.
DV_ENCRYPTION_KEY=

# Health records (wellness trackers, medications, notes) are encrypted under this
# key; when it is unset the DV key above is used. 64 hex characters.
HEALTH_ENCRYPTION_KEY=

# (TOTP_ENCRYPTION_KEY, for authenticator seeds, is set with the sign-in
# settings above and falls back to the DV key too.)

# Keys that used to be current, comma separated, kept only so what they sealed
# can still be opened while a rotation runs. Empty unless you are rotating; see
# docs/runbooks/ENCRYPTION.md before filling any of these.
DV_ENCRYPTION_KEY_PREVIOUS=
HEALTH_ENCRYPTION_KEY_PREVIOUS=
TOTP_ENCRYPTION_KEY_PREVIOUS=

# ===========================================
# TRUST & SAFETY
# ===========================================
# An address on a domain you own; athena.com is not one.
TRUST_SAFETY_EMAIL=trust-safety@your-domain.com
INTERNAL_WEBHOOK_DISABLE_KEY=

# ===========================================
# SENTRY
# ===========================================
SENTRY_ENVIRONMENT=development

# ===========================================
# FEED
# ===========================================
FEED_MAX_POSTS_PER_CREATOR=50

# ===========================================
# LIVESTREAM (Mux / RTMP)
# ===========================================
# RTMP_SERVER_URL=rtmp://live.athena.app/live
# HLS_PLAYBACK_URL=https://stream.athena.app

# ===========================================
# REDIS STREAMS (Event Bus)
# ===========================================
# EVENT_STREAM_KEY=athena:events
# EVENT_STREAM_GROUP=athena-workers
# EVENT_CONSUMER_NAME=worker-1
# EVENT_STREAM_SOURCE=$

# ===========================================
# INCIDENT / TRUST & SAFETY
# ===========================================
# INCIDENT_TEAM_EMAILS=security@athena.com,trust@athena.com

# ===========================================
# APP URL (canonical backend URL for links in emails etc.)
# ===========================================
# APP_URL=https://api.athena.app

# There is no LocalStack wiring in the API: nothing reads LOCALSTACK_ENDPOINT
# or USE_LOCALSTACK, which used to be set here. With the AWS keys above left
# empty, development media is stored in ./uploads.


# ===========================================
# DATABASE SEEDING (Development Only)
# ===========================================
# The /api/admin/seed routes are blocked outright when NODE_ENV=production.
# Outside production they stay disabled until ALLOW_DB_SEEDING=true AND
# SEED_API_TOKEN is set to at least 32 characters. Requests must then send the
# same value in an x-seed-token header. Any gate failing returns 404.
# ALLOW_DB_SEEDING=true
# SEED_API_TOKEN=generate-with-openssl-rand-hex-32

# Admin account created by `npm run db:seed:admin` or POST /api/admin/seed/admin.
# Leave ADMIN_PASSWORD unset to have a strong password generated and printed
# once - it is hashed with bcrypt and never stored or logged in plaintext.
# ADMIN_EMAIL=admin@athena.com
# ADMIN_PASSWORD=
# ADMIN_ROTATE=false

# Override where seeded videos are served from (defaults to a public sample bucket).
# SEED_VIDEO_BASE_URL=https://cdn.example.com/athena-demo

# Australian integrations (optional; each feature says when it is off)
# ABR_GUID=            # abr.business.gov.au web-services GUID: live ABN lookup and business-name search
# BASIQ_API_KEY=       # Basiq API key: bank feeds by consent; pasting a statement works without it
# LEAD_ALERT_EMAIL=    # Where sales, partner, press and creator enquiries are emailed; admins are notified in-app regardless
