# ===========================================
# ATHENA SERVER — RAILWAY PRODUCTION ENV VARS
# ===========================================
# Copy these into Railway Dashboard → Service → Variables
# Variables marked [AUTO] are provided by Railway add-ons automatically.
# Variables marked [REQUIRED] must be set before first deploy.
# Variables marked [RECOMMENDED] should be set for full functionality.

# ===========================================
# CORE (all required)
# ===========================================
NODE_ENV=production
# PORT=                          # [AUTO] Railway injects this
# DATABASE_URL=                  # [AUTO] Railway PostgreSQL add-on
# REDIS_URL=                     # [AUTO] Railway Redis add-on

# [REQUIRED] Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [REQUIRED] Your Netlify frontend URL (for CORS + redirects)
CLIENT_URL=https://athena-empress.netlify.app
FRONTEND_URL=https://athena-empress.netlify.app
ALLOWED_ORIGINS=https://athena-empress.netlify.app
TRUST_PROXY=true
SHUTDOWN_TIMEOUT_MS=10000

# [REQUIRED] Canonical backend URL (for email links, webhooks, etc.)
APP_URL=https://mari-production-5c60.up.railway.app
API_URL=https://mari-production-5c60.up.railway.app

# ===========================================
# PAYMENTS — Stripe
# ===========================================
# [RECOMMENDED] Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
ALLOW_STRIPE_SIMULATION=false
# Price IDs per tier (create in Stripe Dashboard → Products)
STRIPE_PRICE_CAREER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTREPRENEUR=price_xxxxx
STRIPE_PRICE_CREATOR=price_xxxxx

# ===========================================
# AI — OpenAI
# ===========================================
# [RECOMMENDED] Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
AI_OPENAI_API_KEY=sk-...
AI_OPENAI_CHAT_MODEL=gpt-4o
AI_ALLOW_SIMULATION=false
AI_CHAT_FREE_MAX_REQUESTS=10
AI_CHAT_FREE_WINDOW_SECONDS=3600
AI_SOCIAL_CONTENT_ENABLED=true

# ===========================================
# EMAIL — SendGrid
# ===========================================
# [RECOMMENDED] Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@athena.com

# ===========================================
# FILE STORAGE — AWS S3
# ===========================================
# [RECOMMENDED] Create IAM user with S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=athena-uploads-prod
S3_MEDIA_BUCKET=athena-media-prod
S3_UPLOADS_BUCKET=athena-uploads-prod
S3_EXPORTS_BUCKET=athena-exports-prod
S3_BACKUPS_BUCKET=athena-backups-prod

# ===========================================
# CDN (optional — CloudFront)
# ===========================================
# CDN_URL=https://cdn.athena.app
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=

# ===========================================
# ERROR TRACKING — Sentry
# ===========================================
# [RECOMMENDED] Get from https://sentry.io
SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ENVIRONMENT=production

# ===========================================
# PUSH NOTIFICATIONS — Firebase (optional)
# ===========================================
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ===========================================
# VIDEO PROCESSING — Mux (optional)
# ===========================================
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=

# ===========================================
# SEARCH — OpenSearch (optional)
# ===========================================
# OPENSEARCH_NODE=
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# ===========================================
# ML SERVICE (optional — separate Railway service)
# ===========================================
# ML_SERVICE_URL=https://athena-ml-production.up.railway.app
# ML_SERVICE_TIMEOUT=30000

# ===========================================
# SECURITY & OPERATIONS
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ENABLE_WORKERS=true
WORKER_CONCURRENCY=5
METRICS_TOKEN=
LOG_LEVEL=info

# [REQUIRED] 64 hex char AES-256 key — generate with: openssl rand -hex 32
DV_ENCRYPTION_KEY=
TRUST_SAFETY_EMAIL=trust-safety@athena.com
